{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "ignorePatterns": [
    "node_modules",
    "**/node_modules",
    "dist",
    "**/dist",
    ".turbo",
    "**/.turbo",
    ".nuxt",
    "**/.nuxt",
    ".output",
    "**/.output",
    "pnpm-lock.yaml",
    "presentations",
    "docs/content/**/*.md",
    "themes/*/example.md"
  ]
}
