{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["playground", "playground/packages/*", "playground/presentations/*", "docs"],
  "exclude": ["catalog", "exports", "types"],
  "workspaces": {
    ".": {
      "entry": ["vitest.config.ts"],
      "ignore": ["tests/**"],
      "vitest": false,
      "ignoreDependencies": [
        "supaslidev",
        "@vitest/browser",
        "@vitest/coverage-v8",
        "changelogen",
        "tsx"
      ]
    },
    "packages/cli": {
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["tsx"]
    },
    "packages/supaslidev": {
      "entry": ["app/**/*.vue", "server/**/*.ts"],
      "project": ["src/**/*.ts", "app/**/*.{ts,vue}", "server/**/*.ts"],
      "ignoreDependencies": ["js-yaml", "vue-tsc", "@types/js-yaml", "tsx"]
    }
  }
}
