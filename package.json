{
  "version": "0.2.0",
  "private": true,
  "keywords": [
    "slidev",
    "supaslidev"
  ],
  "homepage": "https://github.com/timdamen/supaslidev#readme",
  "bugs": {
    "url": "https://github.com/timdamen/supaslidev/issues"
  },
  "license": "MIT",
  "author": "Tim Damen <hello@timdamen.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timdamen/supaslidev.git"
  },
  "type": "module",
  "scripts": {
    "dev:all": "turbo run dev",
    "build": "pnpm --filter",
    "build:all": "turbo run build",
    "lint": "turbo run lint --continue",
    "typecheck": "turbo run typecheck --continue",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config tests/vitest.config.ts",
    "test:browser:watch": "vitest --config tests/vitest.config.ts",
    "test:ci": "turbo run test --continue",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "test:e2e:ui": "vitest --config tests/e2e/vitest.config.ts --ui",
    "prepare": "husky",
    "coderabbit:auth": "coderabbit auth login",
    "coderabbit:review": "coderabbit --prompt-only --type uncommitted",
    "coderabbit:review:committed": "coderabbit --prompt-only --type committed",
    "coderabbit:review:full": "coderabbit --prompt-only",
    "release": "bumpp package.json packages/*/package.json --all -x \"npx changelogen --no-output\""
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@vitest/browser": "catalog:dev",
    "@vitest/browser-playwright": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "bumpp": "catalog:dev",
    "changelogen": "catalog:dev",
    "changelogithub": "catalog:dev",
    "husky": "catalog:dev",
    "lint-staged": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "playwright": "catalog:dev",
    "supaslidev": "workspace:*",
    "tsx": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "lint-staged": {
    "*.{ts,js,mjs,vue}": [
      "oxlint --fix",
      "oxfmt --write",
      "vitest related --run"
    ],
    "*.json": "oxfmt --write"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.28.1"
}
