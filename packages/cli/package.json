{
  "name": "create-supaslidev",
  "version": "0.1.4",
  "description": "CLI tool for scaffolding Supaslidev presentations",
  "keywords": [
    "slidev",
    "supaslidev"
  ],
  "homepage": "https://github.com/timdamen/supaslidev#readme",
  "bugs": {
    "url": "https://github.com/timdamen/supaslidev/issues"
  },
  "license": "MIT",
  "author": "Tim Damen <hello@timdamen.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timdamen/supaslidev.git",
    "directory": "packages/cli"
  },
  "bin": {
    "create-supaslidev": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../oxlint.json .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "ejs": "^3.1.10",
    "picocolors": "^1.1.1",
    "ts-morph": "^24.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.10.0",
    "tsdown": "^0.12.5",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3",
    "vitest": "^3.0.0"
  }
}
