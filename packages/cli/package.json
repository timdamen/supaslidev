{
  "name": "create-supaslidev",
  "version": "0.4.2",
  "description": "CLI tool for scaffolding Supaslidev presentations",
  "keywords": [
    "slidev",
    "supaslidev"
  ],
  "homepage": "https://github.com/timdamen/supaslidev#readme",
  "bugs": {
    "url": "https://github.com/timdamen/supaslidev/issues"
  },
  "license": "MIT",
  "author": "Tim Damen <hello@timdamen.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timdamen/supaslidev.git",
    "directory": "packages/cli"
  },
  "bin": {
    "create-supaslidev": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../oxlint.json .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "catalog:cli",
    "commander": "catalog:cli",
    "ejs": "catalog:cli",
    "picocolors": "catalog:cli",
    "ts-morph": "catalog:cli",
    "yaml": "catalog:cli"
  },
  "devDependencies": {
    "@types/ejs": "catalog:dev",
    "@types/node": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
