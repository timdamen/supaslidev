{
  "name": "supaslidev",
  "version": "0.1.5",
  "description": "CLI toolkit for managing Supaslidev presentations",
  "keywords": [
    "slidev",
    "supaslidev"
  ],
  "homepage": "https://github.com/timdamen/supaslidev#readme",
  "bugs": {
    "url": "https://github.com/timdamen/supaslidev/issues"
  },
  "license": "MIT",
  "author": "Tim Damen <hello@timdamen.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timdamen/supaslidev.git",
    "directory": "packages/supaslidev"
  },
  "bin": {
    "supaslidev": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "server"
  ],
  "type": "module",
  "main": "./dist/cli/index.js",
  "exports": {
    ".": {
      "import": "./dist/cli/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "dev:api": "node server/api.js",
    "build": "vite build && tsdown",
    "build:cli": "tsdown",
    "preview": "vite preview",
    "generate": "node scripts/generate-presentations.mjs",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.cli.json",
    "lint": "oxlint --config ../../oxlint.json .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nuxt/ui": "catalog:core",
    "commander": "catalog:cli",
    "create-supaslidev": "workspace:^",
    "js-yaml": "catalog:cli",
    "tailwindcss": "catalog:core",
    "vue": "catalog:",
    "vue-router": "catalog:core"
  },
  "devDependencies": {
    "@types/js-yaml": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:core",
    "tsdown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:core",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:core"
  }
}
