{
  "name": "supaslidev",
  "version": "0.3.1",
  "description": "CLI toolkit for managing Supaslidev presentations",
  "keywords": [
    "slidev",
    "supaslidev"
  ],
  "homepage": "https://github.com/timdamen/supaslidev#readme",
  "bugs": {
    "url": "https://github.com/timdamen/supaslidev/issues"
  },
  "license": "MIT",
  "author": "Tim Damen <hello@timdamen.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timdamen/supaslidev.git",
    "directory": "packages/supaslidev"
  },
  "bin": {
    "supaslidev": "./dist/cli/index.js"
  },
  "files": [
    "app",
    "dist",
    "nuxt.config.ts",
    "public",
    "server",
    "src"
  ],
  "type": "module",
  "main": "./nuxt.config.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./layer": "./nuxt.config.ts",
    "./nuxt": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "default": "./src/module.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "tsdown",
    "typecheck": "nuxt typecheck",
    "lint": "oxlint --config ../../oxlint.json .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@nuxt/ui": "catalog:core",
    "commander": "catalog:cli",
    "js-yaml": "catalog:cli",
    "nuxt": "catalog:core",
    "tailwindcss": "catalog:core",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@nuxt/kit": "catalog:core",
    "@nuxt/schema": "catalog:core",
    "@types/js-yaml": "catalog:dev",
    "@types/node": "catalog:dev",
    "create-supaslidev": "workspace:^",
    "tsdown": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "vue-tsc": "catalog:core"
  }
}
